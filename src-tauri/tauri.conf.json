{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RomaWorks DataCollector",
  "version": "0.1.0",
  "identifier": "com.romaworks.datacollector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RomaWorks DataCollector",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
